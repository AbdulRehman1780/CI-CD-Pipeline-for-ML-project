pipeline {
    agent any

    stages {
        stage('Clone Repository') {
            steps {
                git 'https://github.com/AbdulRehman1780/CI-CD-Pipeline-for-ML-project.git'
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -t your-image-name .'
            }
        }

        stage('Test') {
            steps {
                sh 'pytest tests/'
            }
        }

        stage('Push to Docker Hub') {
    steps {
        withDockerRegistry([credentialsId: 'docker-hub-credentials', url: 'https://index.docker.io/v1/']) {
            sh 'docker tag your-image-name your-dockerhub-username/your-image-name:latest'
            sh 'docker push your-dockerhub-username/your-image-name:latest'
        }
    }
}


        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                // Add deployment steps here
            }
        }
    }
}
